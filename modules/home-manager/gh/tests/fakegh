#!/usr/bin/env bash
# Test stub standing in for the real gh binary. Never contacts GitHub.
if [ "$1" = api ] && [[ "${2:-}" == repos/* ]]; then
  [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ] || exit 1
  case "${GH_GUARD_TEST_AUTH_API:-error}" in
    private) printf '%s\n' private ;;
    public) printf '%s\n' public ;;
    *) exit 1 ;;
  esac
  exit 0
fi
if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
  case "$*" in *nameWithOwner*) echo "dryvist/testrepo"; exit 0 ;; esac
  case "$3" in
    dryvist/privaterepo) echo PRIVATE ;;
    dryvist/unknownrepo) exit 1 ;;
    *) echo PUBLIC ;;
  esac
  exit 0
fi
if { [ "$1" = pr ] || [ "$1" = issue ]; } && [ "${2:-}" = view ]; then
  # Stands in for `--json body,author --jq 'select(.author.is_bot)|.body'`.
  [ "${GH_GUARD_TEST_VIEW_BOT:-}" = 1 ] && printf '%s\n' "${GH_GUARD_TEST_VIEW_BODY:-}"
  exit 0
fi
echo "REAL-GH-REACHED: $*"
