#!/usr/bin/env bash
set -u
set -o pipefail

host="$(hostname -s)" || exit 1
[ -n "$host" ] || {
  printf 'd-r: unable to determine the local host attribute\n' >&2
  exit 1
}

# The private host layer sets DARWIN_HOST_FLAKE (github:<owner>/<repo>) once for every Mac;
# that owner's read token covers the host flake and its private inputs.
host_flake="${DARWIN_HOST_FLAKE:-}"
case "$host_flake" in
  github:*/*) ;;
  *)
    printf 'd-r: DARWIN_HOST_FLAKE must be github:<owner>/<repo>; open a new shell after the first activation that sets it\n' >&2
    exit 1
    ;;
esac
flake_owner="${host_flake#github:}"
flake_owner="${flake_owner%%/*}"

old_nix_config="${NIX_CONFIG:-}"
token="$(env -u DOPPLER_PROJECT -u DOPPLER_CONFIG -u DOPPLER_ENVIRONMENT doppler run -- openbao-github-creds token read "$flake_owner")" || {
  printf 'd-r: unable to read the GitHub evaluation token\n' >&2
  exit 1
}

export NIX_CONFIG="${old_nix_config:+$old_nix_config
}access-tokens = github.com=$token"
unset token

# Build stdout is the closure path and stays unprefixed; build stderr (logs) is timestamped.
closure="$(nix build "${host_flake}#darwinConfigurations.${host}.system" \
  --refresh --no-write-lock-file --accept-flake-config --no-link --print-out-paths --print-build-logs \
  2> >(ts-prefix >&2))"
build_rc=$?

if [ -n "$old_nix_config" ]; then
  export NIX_CONFIG="$old_nix_config"
else
  unset NIX_CONFIG
fi
unset old_nix_config

[ "$build_rc" -eq 0 ] || exit "$build_rc"

printf 'closure=%s\n' "$closure" | ts-prefix
sudo -S sh -c 'nix build --profile /nix/var/nix/profiles/system "$1" && "$1/activate-user" && "$1/activate"' d-r "$closure" < /dev/null 2>&1 | ts-prefix
